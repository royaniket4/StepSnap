# ==============================================================================
# StepSnap Environment Configuration
# ==============================================================================
# NOTE: StepSnap works 100% offline and locally without any Supabase credentials!
# Supabase is only required if you want to publish guides to shareable public URLs.
#
# 1. Supabase Project URL (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anonymous Public Key (Safe for browser / client requests)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (OPTIONAL: Server-only for elevated table operations)
# NEVER expose this key in client-side code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...